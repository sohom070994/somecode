{
  "manifest_version": 3,
  "name": "Visa Slot Watcher",
  "version": "0.1.0",
  "description": "Budgeted US visa calendar checks with alerts and autobook, in your own logged-in session.",
  "permissions": ["storage", "alarms", "notifications", "tts", "scripting", "downloads", "cookies", "nativeMessaging", "webRequest"],
  "host_permissions": ["https://www.usvisascheduling.com/*", "https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://www.usvisascheduling.com/*/schedule*", "https://www.usvisascheduling.com/*/ofc-schedule*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.usvisascheduling.com/*/schedule*", "https://www.usvisascheduling.com/*/ofc-schedule*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["config.js", "whatsapp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.usvisascheduling.com/*/appointment-confirmation*"],
      "js": ["confirm.js"],
      "run_at": "document_idle"
    }
  ]
}
